[sqlfluff]
dialect = postgres
templater = dbt
max_line_length = 120
# ST06 reorders columns which breaks select * unions across sources
exclude_rules = structure.column_order

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:references.keywords]
# Allow PRD-defined column names (name, source, value) that overlap with SQL keywords
ignore_words = name,source,synonym,value

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .
